# Local simulator; no token transfers or actual gas measurements.
RELAYER_MODE=mock
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/relayer.sqlite
MOCK_LEDGER_PATH=data/mock-chain.json
CHAIN_ID=31337
EXECUTOR_ADDRESS=0x1000000000000000000000000000000000000001
BATCH_SIZE=10
MAX_WAIT_MS=1000
MAX_ATTEMPTS=3
REBROADCAST_AFTER_MS=5000
MAX_BROADCASTS=3
MAX_GAS_PER_BATCH=5000000
POLL_INTERVAL_MS=250
CONFIRMATIONS=1
