# Copy to .env. Safe local defaults; never add real keys or credentials here.
# Contract chain binds here; contract demo/gas connect here.
RPC_URL=http://127.0.0.1:8545
# Separate chain owned and stopped by verify:local.
VERIFY_PORT=18545

# Relayer defaults to simulation: no token transfers or real gas measurements.
RELAYER_MODE=mock
HOST=127.0.0.1
PORT=3000
RELAYER_URL=http://127.0.0.1:3000
DATABASE_PATH=data/relayer.sqlite
MOCK_LEDGER_PATH=data/mock-chain.json
CHAIN_ID=31337
# Mock signing-domain placeholder; EVM mode requires the deployed executor address.
EXECUTOR_ADDRESS=0x1000000000000000000000000000000000000001
BATCH_SIZE=10
MAX_WAIT_MS=1000
MAX_ATTEMPTS=3
REBROADCAST_AFTER_MS=5000
MAX_BROADCASTS=3
MAX_GAS_PER_BATCH=5000000
POLL_INTERVAL_MS=250
CONFIRMATIONS=1
# First block scanned by GET /agents for AgentConfigured events (EVM mode).
AGENT_INDEX_FROM_BLOCK=0
# EVM mode additionally requires the deployed EXECUTOR_ADDRESS and a dedicated,
# test-only relayer key in private .env:
# RELAYER_PRIVATE_KEY=
